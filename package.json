{
	"name": "podchast",
	"version": "0.1.0",
	"description": "Turn web articles into a private podcast feed on Cloudflare Workers",
	"scripts": {
		"check": "tsc -p .",
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"build": "esbuild src/index.ts --bundle --format=esm --minify-whitespace --minify-syntax --charset=ascii --outfile=dist/worker.js"
	},
	"license": "UNLICENSED",
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261116.1",
		"esbuild": "^0.28.2",
		"typescript": "^7.0.2",
		"wrangler": "^4.162.0"
	},
	"private": true,
	"type": "module"
}

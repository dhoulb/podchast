{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "podchast",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-01",
	"observability": { "enabled": true },
	"workers_dev": true,
	// Bundle the cover image as bytes.
	"rules": [{ "type": "Data", "globs": ["**/*.jpg", "**/*.png"], "fallthrough": false }, { "type": "Text", "globs": ["**/*.md", "**/*.txt"], "fallthrough": true }],
	"r2_buckets": [{ "binding": "AUDIO", "bucket_name": "podchast" }],
	"queues": {
		"producers": [{ "binding": "JOBS", "queue": "podchast-jobs" }],
		"consumers": [{ "queue": "podchast-jobs", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 4, "max_concurrency": 4, "retry_delay": 60 }]
	},
	"ai": { "binding": "AI" },
	"triggers": { "crons": ["17 3 * * *"] },
	// Defaults. A GitHub repository variable with the same name overrides each one on deploy.
	"vars": {
		"FEED_TITLE": "🍖 PODCHAST",
		"RETENTION_DAYS": "90",
		// Edge TTS voice. List: https://speech.platform.bing.com/consumer/speech/synthesize/readaloud/voices/list?trustedclienttoken=6A5AA1D4EAFF4E9FB37E23D68491D6F4
		"VOICE": "en-US-BrianNeural",
		"RATE": "+0%",
		// Edge prosody pitch, such as "-5%" or "-2Hz". Lower is calmer.
		"PITCH": "-8%",
		// Edge output format. 96 kbps sounds clearer than the 48 kbps default. Edge refuses 48 kHz / 192 kbps.
		"EDGE_FORMAT": "audio-24khz-96kbitrate-mono-mp3",
		// "edge-only" (default: Edge, and retry later if it fails), "edge" (Edge, then Workers AI if it fails) or "workers-ai".
		"TTS_ENGINE": "edge-only",
		"AI_MODEL": "@cf/deepgram/aura-2-en",
		"AI_SPEAKER": "",
		// iCloud link to the iOS Shortcut. Shows an "Add to share sheet" button on the status page.
		"SHORTCUT_URL": "https://www.icloud.com/shortcuts/f463e3946d2b458a937e6a63fa85b45a",
		// Link to the source code, shown in /llms.txt. The deploy sets it to the GitHub repository it runs in.
		"REPO": "https://github.com/dhoulb/podchast",
		// DOMAIN: a custom domain for the Worker, such as podchast.example.com. Set it as a GitHub variable. The deploy attaches it.
		// EMAIL_TO: the address that Email Routing sends to this Worker. Set it as a GitHub variable.
	}
	// Secrets TOKEN and EMAIL_FROM: set them as GitHub secrets. The deploy copies them to the Worker.
}

{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "podchast",
	"account_id": "1f3adb483b780d986849fd63602ca46b",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-01",
	"observability": { "enabled": true },
	"workers_dev": true,
	// Bundle the cover image as bytes.
	"rules": [{ "type": "Data", "globs": ["**/*.jpg", "**/*.png"], "fallthrough": false }],
	"r2_buckets": [{ "binding": "AUDIO", "bucket_name": "podchast" }],
	"queues": {
		"producers": [{ "binding": "JOBS", "queue": "podchast-jobs" }],
		"consumers": [{ "queue": "podchast-jobs", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 3, "max_concurrency": 3, "retry_delay": 60 }]
	},
	"ai": { "binding": "AI" },
	"triggers": { "crons": ["17 3 * * *"] },
	"vars": {
		"FEED_TITLE": "🍖 PODCHAST",
		"RETENTION_DAYS": "90",
		// Edge TTS voice. List: https://speech.platform.bing.com/consumer/speech/synthesize/readaloud/voices/list?trustedclienttoken=6A5AA1D4EAFF4E9FB37E23D68491D6F4
		"VOICE": "en-NZ-MitchellNeural",
		"RATE": "+0%",
		// "edge" (default, falls back to Workers AI) or "workers-ai".
		"TTS_ENGINE": "edge",
		"AI_MODEL": "@cf/deepgram/aura-2-en",
		"AI_SPEAKER": "",
		// iCloud link to the iOS Shortcut. Shows an "Add to share sheet" button on the status page.
		"SHORTCUT_URL": "https://www.icloud.com/shortcuts/f463e3946d2b458a937e6a63fa85b45a",
		"EMAIL_TO": "devour@podchast.dhoulb.com"
	}
	// Secret: TOKEN (run `npx wrangler secret put TOKEN`).
}
